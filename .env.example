# Instrumentation — Umami auto-hébergé
#
# Les deux variables sont optionnelles. Tant qu'elles sont absentes, aucun
# script n'est chargé et aucune requête n'est émise : l'outil fonctionne
# à l'identique, simplement sans mesure.
#
# Copier ce fichier en .env.local et renseigner les valeurs une fois le
# serveur Umami en place. .env.local n'est pas versionné.

# URL du serveur Umami. La barre finale est optionnelle.
VITE_UMAMI_URL=https://stats.mauricemendy.com

# Identifiant du site, donné par Umami à la création.
VITE_UMAMI_WEBSITE_ID=
