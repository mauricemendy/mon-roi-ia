# Instrumentation — Umami auto-hébergé
#
# Les deux variables sont optionnelles. Tant qu'elles sont absentes, aucun
# script n'est chargé et aucune requête n'est émise : l'outil fonctionne
# à l'identique, simplement sans mesure.
#
# Copier ce fichier en .env.local et renseigner les valeurs une fois le
# serveur Umami en place. .env.local n'est pas versionné.

# URL du serveur Umami. La barre finale est optionnelle.
VITE_UMAMI_URL=https://stats.mauricemendy.com

# Identifiant du site, donné par Umami à la création.
VITE_UMAMI_WEBSITE_ID=

# Relevés — table du baromètre
#
# Point d'entrée qui insère un relevé anonyme (POST JSON). Optionnel : sans
# lui, aucun relevé n'est envoyé. Schéma de la table et requêtes dans
# docs/barometre-schema.md.
VITE_METRON_COLLECT_URL=

# Inscription — Worker de capture vers Brevo (double opt-in)
#
# Optionnel : sans lui, le bloc d'inscription n'apparaît pas. La clé Brevo et
# le routage vers la bonne liste vivent dans le Worker, jamais ici.
# Contrat d'attributs : docs/capture-contrat.md
VITE_METRON_SUBSCRIBE_URL=
